# Commit the research code and curated evidence, not this dataset workspace.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/LICENSE
!/pyproject.toml
!/canon6d/
!/tests/
!/CONTRIBUTING.md
!/NOTICE.md
!/Makefile
!/configs/
!/docs/
!/requirements/
!/results/
!/scripts/
!/tools/
!/.github/
!/paper/

# Only the current, standalone manuscript belongs in the source repository.
/paper/*
!/paper/current/
/paper/current/build/
/paper/current/manuscript_source.zip

# Python, editor state, local configuration and secrets.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store
.env
.env.*
*.local.json
*.local.yaml
*.local.yml
*.swp
*~

# Heavy experimental outputs and generated compiler files.
*.pt
*.pth
*.ckpt
*.npz
*.npy
*.pkl
*.pickle
*.lmdb
*.mdb
*.safetensors
*.onnx
*.zip
*.tar
*.tar.gz
*.aux
*.bbl
*.blg
*.brf
*.log
*.out
*.synctex.gz
